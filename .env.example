PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/hr_system_demo
INDEED_APPLY_API_TOKEN=your_indeed_apply_api_token_here
INDEED_APPLY_SECRET=your_indeed_apply_secret_here
JWT_SECRET=your-super-secret-jwt-key-change-in-production
QR_SECRET=your-qr-signing-secret-change-in-production
JWT_EXPIRES_IN=8h
QR_TOKEN_TTL=180

# Local dev: http://localhost:5173 (Vite) or http://localhost:8080 (Docker)
# Production: set to your Vercel frontend URL, e.g. https://hr-system-demo.vercel.app
CORS_ORIGIN=http://localhost:5173

# Set to "true" to wipe the database and re-seed on next startup (Railway demo reset)
# FORCE_SEED=true

# Production-safe seed: only ensures a super admin exists (no wipes, no demo data)
# PRODUCTION_SEED=true
# SUPER_ADMIN_EMAIL=admin@fusarouomo.com
# SUPER_ADMIN_PASSWORD=password123
# DEFAULT_COMPANY_NAME=FUSARO UOMO
# DEFAULT_COMPANY_SLUG=fusaro-uomo

# Optional: avatar uploads directory (default: <backend cwd>/uploads/avatars). Docker sets /uploads/avatars.
# UPLOADS_DIR=/path/to/uploads/avatars

# External affluence MySQL (DEPOSITI + INGRESSI)
EXTERNAL_AFFLUENCE_DB_HOST=98.71.131.47
EXTERNAL_AFFLUENCE_DB_PORT=3306
EXTERNAL_AFFLUENCE_DB_USER=lettura
EXTERNAL_AFFLUENCE_DB_PASSWORD=LpTsTwRd
EXTERNAL_AFFLUENCE_DB_NAME=sam
# Optional tuning: visitors mapped to one staff unit for recommendations
EXTERNAL_AFFLUENCE_VISITORS_PER_STAFF=10

# ── Payment & Billing Engine (Milestone 1) ──────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
STRIPE_PRICE_EMPLOYEE_MONTHLY=price_optional_precreated_employee_price_id
STRIPE_PRICE_DEVICE_MONTHLY=price_optional_precreated_device_price_id
# The Tax Rate created once in the Stripe dashboard (Product catalogue > Tax
# rates). It must be EXCLUSIVE - tax charged on top of the licence price - and
# its percentage must match BILLING_TAX_PERCENT below. Attached to every
# subscription and to every mid-period licence charge, so Stripe computes and
# shows the subtotal, the tax and the total it collects.
STRIPE_TAX_RATE_ID=txr_your_stripe_tax_rate_id_here

# PayPal
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
# Required: PayPal webhooks are rejected when this is unset.
# sandbox | live - chooses which PayPal to bill against, independently of
# NODE_ENV, so a staging server in production mode can still use sandbox.
PAYPAL_ENV=sandbox

# Default billing behavior
BILLING_REMINDER_DAYS_BEFORE=3
BILLING_GRACE_PERIOD_DAYS=3

# FALLBACK ONLY. Stripe is the source of truth for the tax rate: the backend
# reads STRIPE_TAX_RATE_ID at startup, daily, and whenever "Sincronizza" is
# pressed on the billing page, and mirrors the percentage into the
# billing_tax_settings table. Everything on screen, and the percentage written
# onto the PayPal plan, comes from that mirror.
#
# This value is used only before the first successful sync, or if Stripe has
# never been reachable. Set it to the same number as the Stripe rate so a
# cold start with no network still bills correctly. Unset or 0 = bill net.
BILLING_TAX_PERCENT=22

# Who to copy when a customer's payment fails, so they can be contacted before
# the grace period runs out. Comma-separated; leave empty to send no copy.
BILLING_ALERT_EMAIL=

